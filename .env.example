# Copy to .env for local development (.env is git-ignored). Never reuse these values in production.
# Variables are documented in docs/02-architecture.md, section 8.

# --- Dev compose services (deploy/docker-compose.dev.yml) ---
POSTGRES_DB=tip
POSTGRES_USER=tip
POSTGRES_PASSWORD=tip_dev_password
POSTGRES_PORT=5432
REDIS_PASSWORD=redis_dev_password
REDIS_PORT=6379

# --- tipd ---
HTTP_ADDR=:8080
# /metrics and /debug/pprof; keep it on an internal network only.
INTERNAL_ADDR=127.0.0.1:9090
DATABASE_URL=postgres://tip:tip_dev_password@127.0.0.1:5432/tip?sslmode=disable
REDIS_URL=redis://:redis_dev_password@127.0.0.1:6379/0
# open: skip the access-token blacklist when Redis is down (alerting); closed: answer 503.
REDIS_FAIL_MODE=open
AUTO_MIGRATE=true
DATA_DIR=./.data
# Extra allowed Origins for WebSocket and CSRF checks, comma separated.
ALLOWED_ORIGINS=http://localhost:5173

# Secrets: at least 32 bytes each; the two JWT secrets must differ. Generate with `openssl rand -base64 48`.
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-fedcba9876543210
PASSWORD_PEPPER=dev-password-pepper-change-me-0123456789abcdef
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

FORCE_PASSWORD_CHANGE=false
SWAGGER_ENABLED=true
# Public Grafana address for the admin menu link; leave empty when there is none (local development).
GRAFANA_URL=

# Creates the first admin when no users exist (both or neither; password at least 8 characters).
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=admin-dev-password

# --- Limits ---
MAX_IMAGE_MB=10
MAX_IMAGE_PIXELS=16000000
MIN_FREE_DISK_MB=1024
UPLOADS_MAX_TOTAL_MB=800
AUDIT_RETENTION_DAYS=30
AUDIT_MAX_ROWS=100000

# --- Observability ---
# Probed by the admin system page; set to off to hide the check (no Loki in local development).
LOKI_URL=off
# Prometheus textfile written by the backup container (admin system page).
BACKUP_METRICS_PATH=./.data/backups/backup.prom
LOG_LEVEL=debug
# Retention for logs and metrics in days (read by the compose stack).
OBS_RETENTION_DAYS=3
