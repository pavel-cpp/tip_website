    {
      "id": 16,
      "type": "timeseries",
      "title": "RAM against its limit",
      "description": "Containers with a memory limit only. Close to 100% means the container is about to be killed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "tip_container_memory_working_set_bytes / (tip_container_memory_limit_bytes > 0)",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
