# Caddy is the only public edge of the stack: automatic HTTPS (certificate issued and renewed by Caddy itself,
# kept in the `caddy` volume) and a reverse proxy to tipd.
# Prometheus and Loki are intentionally not proxied: they stay on the internal Docker network.
# Variables come from the caddy service environment (docker-compose.prod.yml).

{
	# Empty unless the operator sets ACME_EMAIL / ACME_CA in prod.env; compose turns them into the whole option
	# line ("email x@y", "acme_ca <url>"), so an empty value does not leave a broken directive behind.
	{$ACME_EMAIL_OPT}
	{$ACME_CA_OPT}
	# Slow-header clients are cut off early. The admin API stays on localhost inside the container.
	servers {
		timeouts {
			read_header 10s
		}
	}
	# No trusted_proxies on purpose: nothing sits in front of Caddy, so an X-Forwarded-For sent by a client is
	# not trusted and reverse_proxy replaces it with the real remote address.
}

# Shared snippets -----------------------------------------------------------

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

# One JSON access log line per request on stdout (picked up by Vector).
(access_log) {
	log {
		output stdout
		format json
	}
}

# Application -------------------------------------------------------------

{$DOMAIN} {
	import security_headers
	import access_log
	encode zstd gzip

	# Metrics and pprof live on the internal listener; never expose them even
	# if the app ever serves them on the public port.
	@internal path /metrics /debug/pprof /debug/pprof/*
	respond @internal 404

	# Image uploads are limited to 10 MB by the app; leave headroom for the
	# multipart envelope.
	request_body {
		max_size 12MB
	}

	# Optional /grafana (conf.d/grafana.caddy, present only when enabled). It sits before the catch-all proxy below:
	# a matched handle block ends the request, so everything else still goes to tipd.
	import conf.d/*.caddy

	# WebSocket upgrades are proxied transparently. The Content-Security-Policy
	# header is set by tipd, which knows the exact asset origins.
	# A short check interval keeps the window of 503s small after tipd is replaced: an upstream that failed a check
	# during a restart stays marked down until the next check passes.
	reverse_proxy tipd:8080 {
		lb_try_duration 5s
		health_uri /healthz
		health_interval 3s
		health_timeout 2s
	}
}

# Readiness probe for deploy.sh: plain HTTP inside the container (never published), so a deploy is judged by the
# app and the proxy, not by certificate issuance, which can take a moment or depend on DNS.
http://127.0.0.1:8081 {
	bind 127.0.0.1
	reverse_proxy tipd:8080
}
