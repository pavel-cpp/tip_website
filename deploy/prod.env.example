# TIP production environment. Copy to deploy/prod.env, fill in every CHANGE_ME
# value and keep the file private (chmod 600). It is read by Docker Compose:
#   docker compose -f deploy/docker-compose.prod.yml --env-file deploy/prod.env up -d
#
# Quoting: values containing '$' (bcrypt hashes) MUST be wrapped in single
# quotes, otherwise Compose tries to interpolate them.
# Generate random secrets with:  openssl rand -hex 32

# ---- Images ----------------------------------------------------------------
# Image built from deploy/Dockerfile (or pulled from your registry). On the shared server deploy.sh sets both
# TIPD_IMAGE and BACKUP_IMAGE per release (ghcr.io/<owner>/<repo>/{tipd,backup}:<tag>), these are the defaults.
TIPD_IMAGE=tip/tipd:latest
BACKUP_IMAGE=tip/backup:local

# ---- Public site (Caddy is the only edge and gets the certificate itself) -----------------------------------
# Public host name of the app. DNS must point to the server; ports 80/443 open.
DOMAIN=tip.example.com
# E-mail for Let's Encrypt expiry notices. May be left EMPTY (no address, no notices; renewal still runs).
ACME_EMAIL=
# Certificate authority. Empty = Let's Encrypt production. For a first run use the staging CA (no rate limits, the
# certificate is not trusted by browsers), then clear it and redeploy:
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=
# Optional Grafana sub-domain (the `obs` profile plus caddy.d/grafana.caddy, see caddy.d/grafana.caddy.example):
# basic auth in front of Grafana's own login. Unused otherwise.
GRAFANA_DOMAIN=grafana.tip.example.com
# Caddy basic auth in front of Grafana. Hash: docker run --rm caddy:2.9-alpine caddy hash-password
# Keep the single quotes around the hash.
GRAFANA_BASIC_AUTH_USER=ops
GRAFANA_BASIC_AUTH_HASH='$2a$14$CHANGE_ME_bcrypt_hash_from_caddy_hash_password'

# ---- tipd (see docs/02-architecture.md section 8) -----------------------------
# HMAC keys, at least 32 random bytes each, all three values different.
JWT_ACCESS_SECRET=CHANGE_ME_64_hex_chars
JWT_REFRESH_SECRET=CHANGE_ME_64_hex_chars_different
PASSWORD_PEPPER=CHANGE_ME_64_hex_chars_third
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# First admin, created only when the users table is empty. Change the password
# after the first login, then these two lines may be removed.
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_strong_password
FORCE_PASSWORD_CHANGE=false
# Extra allowed Origin values for WebSocket/CSRF, comma separated. The public
# host is allowed by default; set explicitly when it differs.
ALLOWED_ORIGINS=https://tip.example.com
# open: skip the access-token blacklist when Redis is down (with alert);
# closed: answer 503 instead.
REDIS_FAIL_MODE=open
SWAGGER_ENABLED=true
LOG_LEVEL=info
AUTO_MIGRATE=true
MAX_IMAGE_MB=10
MAX_IMAGE_PIXELS=16000000
# Free-space floor and upload ceiling (the disk is only 10 GB, see docs/05 6.1).
MIN_FREE_DISK_MB=1024
UPLOADS_MAX_TOTAL_MB=800
AUDIT_RETENTION_DAYS=30
AUDIT_MAX_ROWS=100000

# ---- PostgreSQL ----------------------------------------------------------------
POSTGRES_DB=tip
POSTGRES_USER=tip
# Use URL-safe characters only (hex): it is embedded into DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME_hex_password

# ---- Redis ----------------------------------------------------------------------
# Use URL-safe characters only (hex): it is embedded into REDIS_URL.
REDIS_PASSWORD=CHANGE_ME_hex_password

# ---- Observability ----------------------------------------------------------------
# Loki, Vector and Grafana run only with `--profile obs` (they do not fit next to other workloads on 2 GB).
# Without the profile Prometheus + node_exporter still run and the admin status page skips the Loki probe.
# With the profile set LOKI_URL=http://loki:3100 (default "off") and GRAFANA_URL (shown in the admin menu).
LOKI_URL=off
GRAFANA_URL=
# Retention of logs (Loki) and metrics (Prometheus) in days, 3 to 5.
# Applied on restart: docker compose up -d
OBS_RETENTION_DAYS=3
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_strong_password

# Alerting: Grafana-managed alerts (no Telegram). Both channels are optional;
# the defaults below keep the contact point valid but deliver nowhere.
# E-mail through your SMTP provider (Yandex 360, Mail.ru for business, corporate).
GF_SMTP_ENABLED=false
GF_SMTP_HOST=smtp.example.com:587
GF_SMTP_USER=alerts@example.com
GF_SMTP_PASSWORD=CHANGE_ME
GF_SMTP_FROM_ADDRESS=alerts@example.com
GF_SMTP_FROM_NAME=TIP alerts
ALERT_EMAIL_TO=admin@example.com
# Generic webhook (VK Teams bot, Max, any HTTP endpoint accepting Grafana JSON).
ALERT_WEBHOOK_URL=http://127.0.0.1:9/disabled

# ---- Backups -----------------------------------------------------------------------
# Cron schedule (container time is UTC) and the number of DB dumps kept locally.
BACKUP_CRON=30 1 * * *
BACKUP_KEEP=3
# Skip a backup if less than this much space (MB) would remain after it.
BACKUP_MIN_FREE_MB=1500
# Off-site upload through rclone. Leave BACKUP_REMOTE empty to disable.
# The remote must be a crypt remote defined in the rclone config, for example
# "tipcrypt:" (a crypt wrapper over an S3/SFTP remote), optionally with a path.
BACKUP_REMOTE=
# Host path of the rclone.conf file (mounted read-only as a secret). The file
# contains the storage credentials and the crypt password: keep a copy of it
# away from the server, without it off-site backups cannot be decrypted.
RCLONE_CONFIG_FILE=/opt/tip/secrets/rclone.conf
