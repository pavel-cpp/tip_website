# Grafana under /grafana on the main domain (no extra DNS record or certificate). Off by default. To enable
# (needs the `obs` compose profile):
#   cp caddy.d/grafana.caddy.example caddy.d/grafana.caddy     (in /opt/tip)
#   set GRAFANA_URL=https://<DOMAIN>/grafana/ in prod.env, then
#   docker compose -p tip -f docker-compose.prod.yml --env-file prod.env up -d
#   docker compose -p tip -f docker-compose.prod.yml --env-file prod.env exec caddy caddy reload --config /etc/caddy/Caddyfile
# This file is imported inside the main site block (see the Caddyfile), so it holds directives, not a site.
# Access is guarded by Grafana's own login only: keep GRAFANA_ADMIN_PASSWORD long and random.

@grafana path /grafana /grafana/*
handle @grafana {
	reverse_proxy grafana:3000
}
